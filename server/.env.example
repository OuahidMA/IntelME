# ---- Database ----
MONGODB_URI=

# ---- Server ----
PORT=5000
NODE_ENV=development

# CORS: the only origin allowed to call this API.
CLIENT_URL=http://localhost:5173

# ---- Auth ----
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- AI (Groq) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- Uploads ----
MAX_FILE_SIZE_MB=5
