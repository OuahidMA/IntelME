# ---- Database ----
MONGODB_URI=

# ---- Server ----
PORT=5000
NODE_ENV=development

# CORS: the only origins allowed to call this API from a browser. Comma-separated.
# `CLIENT_URL` is still read as a fallback if `CLIENT_ORIGIN` is unset.
# A single `*` matches one label, which is how a Vercel project and all of its
# preview deployments are allowed at once. Prefer listing exact origins.
# http://localhost:5173 and http://127.0.0.1:5173 are always allowed so that
# `npm run dev` keeps working regardless of what is set here.
CLIENT_ORIGIN=http://localhost:5173
# CLIENT_ORIGIN=https://intelme.app,https://*.vercel.app

# ---- Auth ----
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- AI (Groq) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- Uploads ----
# The largest PDF/DOCX we will parse. Each upload is written to server/uploads,
# read, and deleted before the response is sent — nothing is kept.
MAX_FILE_SIZE_MB=5
