# ---- Client (Vite) ----
# Only variables prefixed with VITE_ are exposed to the browser bundle. Anything
# else here is invisible to the client — which is correct, because the Groq API
# key and the Mongo URI live in server/.env and must never reach the browser.
#
# VITE_API_URL is the public origin of the Express API. The `/api` prefix is
# appended by src/Services/config.js, so give the origin only.
#
#   local        -> http://localhost:5000
#   production   -> https://api.your-domain.com
#
# A value that already ends in /api is tolerated rather than producing /api/api.
VITE_API_URL=http://localhost:5000

# Copy this file to `.env.local` and edit that for machine-specific overrides —
# `.env.local` is git-ignored, so a local override is never committed.